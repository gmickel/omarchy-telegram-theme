"""Generate a Telegram Desktop palette from Omarchy's active colors.toml."""

from __future__ import annotations

import argparse
import base64
import colorsys
import gzip
import io
import os
from pathlib import Path
import re
import struct
import sys
import tempfile
import tomllib
import zipfile
import zlib


HEX_VALUE = re.compile(r"^#([0-9a-fA-F]{6})([0-9a-fA-F]{2})?$")
PALETTE_LINE = re.compile(
    r"^(?P<prefix>[A-Za-z_][A-Za-z0-9_]*:\s*)(?P<value>[^;]+)(?P<suffix>;.*)$"
)
REQUIRED_COLORS = (
    "accent",
    "selection",
    "muted",
    "background",
    "dark_background",
    "darker_background",
    "lighter_background",
    "foreground",
    "dark_foreground",
    "light_foreground",
    "bright_foreground",
    "red",
    "yellow",
    "green",
    "cyan",
    "blue",
    "magenta",
)


class ThemeError(RuntimeError):
    pass


def xdg_path(variable: str, fallback: Path) -> Path:
    value = os.environ.get(variable)
    return Path(value).expanduser() if value else fallback


def default_colors_file() -> Path:
    state_home = xdg_path("XDG_STATE_HOME", Path.home() / ".local/state")
    current = state_home / "omarchy/current/theme/colors.toml"
    legacy = Path.home() / ".config/omarchy/current/theme/colors.toml"
    return current if current.exists() or not legacy.exists() else legacy


def default_output_file() -> Path:
    # Prefer an explicit override, then a self-contained checkout path, then XDG.
    override = os.environ.get("OMARCHY_TELEGRAM_THEME_OUTPUT")
    if override:
        return Path(override).expanduser()

    repo_output = (
        Path(__file__).resolve().parent.parent
        / "generated"
        / "omarchy.tdesktop-theme"
    )
    if (repo_output.parent.parent / "install.sh").is_file():
        return repo_output

    state_home = xdg_path("XDG_STATE_HOME", Path.home() / ".local/state")
    # Prefer .tdesktop-theme so Settings → Chat settings → Import existing theme
    # can see it. ZIP content still includes colors.tdesktop-palette for loaders
    # that look for that inner name.
    return state_home / "omarchy-telegram-theme/omarchy.tdesktop-theme"


def find_base_palette() -> Path:
    data_home = xdg_path("XDG_DATA_HOME", Path.home() / ".local/share")
    candidates = (
        Path(__file__).resolve().parent.parent
        / "assets/day-custom-base.palette.gz.b64",
        data_home
        / "omarchy-telegram-theme/assets/day-custom-base.palette.gz.b64",
    )
    for candidate in candidates:
        if candidate.is_file():
            return candidate
    raise ThemeError(
        "base palette not found; reinstall the project or pass --base-palette"
    )


def normalize_hex(value: object, key: str) -> str:
    if not isinstance(value, str) or not re.fullmatch(
        r"#[0-9a-fA-F]{6}", value
    ):
        raise ThemeError(f"{key} must be a #RRGGBB color, got {value!r}")
    return value.lower()


def first_color(document: dict[str, object], *keys: str) -> object | None:
    return next((document[key] for key in keys if document.get(key)), None)


def resolve_omarchy_colors(
    document: dict[str, object], colors_path: Path
) -> dict[str, str]:
    """Resolve legacy palettes using Omarchy's semantic-color fallbacks."""
    resolved = dict(document)

    legacy_palette_aliases = {
        "background": "bg",
        "dark_background": "dark_bg",
        "darker_background": "darker_bg",
        "lighter_background": "lighter_bg",
        "foreground": "fg",
        "dark_foreground": "dark_fg",
        "light_foreground": "light_fg",
        "bright_foreground": "bright_fg",
    }
    for canonical, legacy in legacy_palette_aliases.items():
        if not resolved.get(canonical) and resolved.get(legacy):
            resolved[canonical] = resolved[legacy]

    if not resolved.get("background"):
        resolved["background"] = resolved.get("color0")
    if not resolved.get("foreground"):
        resolved["foreground"] = resolved.get("color7")
    if resolved.get("background"):
        resolved["color0"] = resolved["background"]
    if resolved.get("foreground"):
        resolved["color7"] = resolved["foreground"]

    ansi_aliases = {
        "red": "color1",
        "green": "color2",
        "yellow": "color3",
        "blue": "color4",
        "magenta": "color5",
        "cyan": "color6",
    }
    for semantic, ansi in ansi_aliases.items():
        if not resolved.get(semantic) and resolved.get(ansi):
            resolved[semantic] = resolved[ansi]
    if not resolved.get("magenta") and resolved.get("purple"):
        resolved["magenta"] = resolved["purple"]

    resolved["light_foreground"] = first_color(
        resolved, "light_foreground", "color7", "foreground"
    )
    resolved["bright_foreground"] = first_color(
        resolved, "bright_foreground", "color15", "foreground"
    )
    resolved["lighter_background"] = first_color(
        resolved, "lighter_background", "color0", "background"
    )
    resolved["dark_foreground"] = first_color(
        resolved, "dark_foreground", "color8", "foreground"
    )
    resolved["muted"] = first_color(
        resolved, "muted", "color8", "dark_foreground"
    )
    resolved["selection"] = first_color(
        resolved,
        "selection",
        "selection_background",
        "color8",
        "color0",
        "background",
    )

    background = normalize_hex(resolved.get("background"), "background")
    if not resolved.get("dark_background"):
        resolved["dark_background"] = mix(background, "#000000", 0.25)
    if not resolved.get("darker_background"):
        resolved["darker_background"] = mix(background, "#000000", 0.50)

    mode = first_color(resolved, "mode", "theme_type")
    if not mode:
        if (colors_path.parent / "light.mode").is_file():
            mode = "light"
        else:
            red, green, blue = rgb(background)
            mode = "light" if red + green + blue > 382 else "dark"
    if mode not in ("dark", "light"):
        raise ThemeError(f"mode must be 'dark' or 'light', got {mode!r}")

    colors = {"mode": mode}
    for key in REQUIRED_COLORS:
        colors[key] = normalize_hex(resolved.get(key), key)
    return colors


def read_omarchy_colors(path: Path) -> dict[str, str]:
    try:
        with path.open("rb") as stream:
            document = tomllib.load(stream)
    except FileNotFoundError as error:
        raise ThemeError(f"Omarchy colors file not found: {path}") from error
    except tomllib.TOMLDecodeError as error:
        raise ThemeError(f"invalid TOML in {path}: {error}") from error

    return resolve_omarchy_colors(document, path)


def read_base_palette(path: Path) -> str:
    try:
        encoded = "".join(path.read_text(encoding="ascii").split())
        return gzip.decompress(base64.b64decode(encoded, validate=True)).decode(
            "utf-8"
        )
    except (OSError, ValueError, UnicodeError) as error:
        raise ThemeError(f"could not decode base palette {path}: {error}") from error


def rgb(value: str) -> tuple[int, int, int]:
    match = HEX_VALUE.fullmatch(value)
    if not match:
        raise ThemeError(f"invalid color: {value}")
    raw = match.group(1)
    return tuple(int(raw[index : index + 2], 16) for index in (0, 2, 4))


def hex_color(value: tuple[float, float, float]) -> str:
    # Match Omarchy's awk mixer, which rounds channel midpoints up.
    channels = tuple(max(0, min(255, int(channel + 0.5))) for channel in value)
    return "#{:02x}{:02x}{:02x}".format(*channels)


def mix(first: str, second: str, amount: float) -> str:
    one, two = rgb(first), rgb(second)
    return hex_color(
        tuple(a * (1.0 - amount) + b * amount for a, b in zip(one, two))
    )


def rgba(value: str, alpha: str) -> str:
    return value + alpha.lower()


def contrast_ratio(first: str, second: str) -> float:
    def luminance(value: str) -> float:
        channels = []
        for channel in rgb(value):
            normalized = channel / 255.0
            channels.append(
                normalized / 12.92
                if normalized <= 0.04045
                else ((normalized + 0.055) / 1.055) ** 2.4
            )
        return (
            0.2126 * channels[0]
            + 0.7152 * channels[1]
            + 0.0722 * channels[2]
        )

    lighter, darker = sorted((luminance(first), luminance(second)), reverse=True)
    return (lighter + 0.05) / (darker + 0.05)


def ensure_contrast(
    color: str,
    background: str,
    preferred: str,
    minimum: float,
) -> str:
    """Move a theme color only as far as needed to remain readable."""
    if contrast_ratio(color, background) >= minimum:
        return color

    target = max(
        (preferred, "#000000", "#ffffff"),
        key=lambda candidate: contrast_ratio(candidate, background),
    )
    for step in range(1, 21):
        candidate = mix(color, target, step / 20)
        if contrast_ratio(candidate, background) >= minimum:
            return candidate
    return target


def color_distance(first: str, second: str) -> float:
    """Euclidean RGB distance; used to keep chat bubbles distinguishable."""
    one, two = rgb(first), rgb(second)
    return sum((a - b) ** 2 for a, b in zip(one, two)) ** 0.5


def message_bubble_colors(colors: dict[str, str]) -> tuple[str, str, str, str]:
    """Pick incoming/outgoing bubble colors that stay in-theme but read apart.

    Previous logic tinted outgoing bubbles with only ~11–18% accent, so on
    green/teal Omarchy themes they looked almost identical to incoming
    (lighter_background) bubbles.
    """
    bg = colors["background"]
    dark_bg = colors["dark_background"]
    lighter_bg = colors["lighter_background"]
    accent = colors["accent"]
    selection = colors["selection"]
    muted = colors["muted"]
    cyan = colors["cyan"]
    blue = colors["blue"]
    green = colors["green"]
    fg = colors["foreground"]  # used for light-mode incoming fallback

    # Minimum separation that still feels obvious in a dense chat transcript.
    # Message text contrast is handled separately via historyText*Fg.
    min_distance = 55.0 if colors["mode"] == "dark" else 50.0

    if colors["mode"] == "dark":
        # Incoming: neutral lifted surface (their messages).
        received = mix(bg, lighter_bg, 0.90)
        sent_candidates = (
            mix(bg, accent, 0.48),
            mix(dark_bg, accent, 0.55),
            mix(bg, accent, 0.62),
            mix(mix(bg, accent, 0.40), cyan, 0.35),
            mix(mix(bg, accent, 0.40), blue, 0.35),
            mix(mix(bg, accent, 0.35), green, 0.35),
            mix(bg, cyan, 0.45),
            mix(bg, blue, 0.48),
        )
    else:
        # Incoming: soft gray surface; outgoing gets a clear accent wash.
        received = mix(bg, muted, 0.20)
        if color_distance(received, bg) < 12:
            received = mix(bg, fg, 0.12)
        sent_candidates = (
            mix(bg, accent, 0.34),
            mix(bg, accent, 0.42),
            mix(bg, accent, 0.52),
            mix(mix(bg, accent, 0.36), cyan, 0.28),
            mix(mix(bg, accent, 0.36), blue, 0.30),
            mix(mix(bg, accent, 0.34), green, 0.28),
            mix(bg, cyan, 0.34),
            mix(bg, blue, 0.36),
        )

    sent = max(sent_candidates, key=lambda candidate: color_distance(candidate, received))
    if color_distance(sent, received) < min_distance:
        for amount in (0.70, 0.60, 0.50, 0.40):
            fallback = (
                mix(dark_bg, accent, amount)
                if colors["mode"] == "dark"
                else mix(bg, accent, amount)
            )
            if color_distance(fallback, received) > color_distance(sent, received):
                sent = fallback
            if color_distance(sent, received) >= min_distance:
                break

    received_selected = mix(received, selection, 0.55)
    sent_selected = mix(sent, selection, 0.45)
    return received, received_selected, sent, sent_selected


def nearest_semantic_color(
    hue: float, colors: dict[str, str]
) -> str:
    anchors = (
        (0.00, colors["red"]),
        (0.12, colors["yellow"]),
        (0.33, colors["green"]),
        (0.50, colors["cyan"]),
        (0.61, colors["accent"]),
        (0.83, colors["magenta"]),
    )
    return min(
        anchors, key=lambda item: min(abs(hue - item[0]), 1.0 - abs(hue - item[0]))
    )[1]


def recolor_literal(key: str, value: str, colors: dict[str, str]) -> str:
    """Map every upstream literal so omitted/obscure UI keys still harmonize."""
    match = HEX_VALUE.fullmatch(value.strip())
    if not match:
        return value.strip()

    source = tuple(int(match.group(1)[i : i + 2], 16) / 255 for i in (0, 2, 4))
    hue, lightness, saturation = colorsys.rgb_to_hls(*source)

    inverted_surface = key.startswith(
        (
            "call",
            "groupCall",
            "mediaview",
            "toast",
            "msgDateImg",
            "videoPlay",
        )
    )
    shadow_or_mask = any(
        marker in key.lower()
        for marker in ("shadow", "fadeout", "overlay", "scrim")
    )

    if saturation < 0.14 and shadow_or_mask and lightness < 0.08:
        target = "#000000"
    elif saturation < 0.14 and inverted_surface:
        target = mix(
            colors["darker_background"], colors["bright_foreground"], lightness
        )
    elif saturation < 0.14:
        target = mix(colors["foreground"], colors["background"], lightness)
    else:
        semantic = nearest_semantic_color(hue, colors)
        semantic_weight = max(0.16, 1.0 - abs(lightness - 0.5) * 1.75)
        backdrop = (
            colors["background"] if lightness >= 0.5 else colors["foreground"]
        )
        target = mix(backdrop, semantic, semantic_weight)

    return rgba(target, match.group(2)) if match.group(2) else target


def palette_overrides(colors: dict[str, str]) -> dict[str, str]:
    bg = colors["background"]
    dark_bg = colors["dark_background"]
    darker_bg = colors["darker_background"]
    lighter_bg = colors["lighter_background"]
    fg = colors["foreground"]
    dark_fg = colors["dark_foreground"]
    light_fg = colors["light_foreground"]
    bright_fg = colors["bright_foreground"]
    accent = colors["accent"]
    selection = colors["selection"]
    muted = colors["muted"]
    red = colors["red"]
    green = colors["green"]

    active_fg = max(
        (bright_fg, darker_bg), key=lambda color: contrast_ratio(color, accent)
    )
    active_over = mix(accent, bright_fg, 0.12)
    active_ripple = mix(accent, bright_fg, 0.22)
    received_bg, received_selected, sent_bg, sent_selected = message_bubble_colors(
        colors
    )
    secondary_fg = ensure_contrast(dark_fg, bg, fg, 4.5)
    secondary_over_fg = ensure_contrast(light_fg, lighter_bg, bright_fg, 4.5)
    secondary_dark_fg = ensure_contrast(dark_fg, dark_bg, fg, 4.5)
    bubble_text_fallback = bright_fg if colors["mode"] == "dark" else darker_bg
    history_in_fg = ensure_contrast(fg, received_bg, bubble_text_fallback, 4.5)
    history_out_fg = ensure_contrast(fg, sent_bg, bubble_text_fallback, 4.5)
    message_secondary_fg = ensure_contrast(dark_fg, received_bg, history_in_fg, 4.5)
    message_out_secondary_fg = ensure_contrast(
        mix(dark_fg, accent, 0.35), sent_bg, history_out_fg, 4.5
    )
    # Reply author names / forwarded labels (msg*ServiceFg) and read-receipt
    # ticks (historyOutIconFg) sit ON the bubble. After we made outgoing
    # bubbles accent-heavy, raw accent-on-accent became unreadable.
    in_service_fg = ensure_contrast(accent, received_bg, history_in_fg, 4.5)
    out_service_fg = ensure_contrast(accent, sent_bg, history_out_fg, 4.5)
    in_service_fg_selected = ensure_contrast(
        accent, received_selected, history_in_fg, 4.5
    )
    out_service_fg_selected = ensure_contrast(
        accent, sent_selected, history_out_fg, 4.5
    )
    out_icon_fg = ensure_contrast(
        mix(history_out_fg, accent, 0.20), sent_bg, history_out_fg, 3.5
    )
    out_icon_fg_selected = ensure_contrast(
        mix(history_out_fg, accent, 0.20), sent_selected, history_out_fg, 3.5
    )
    in_reply_bar = ensure_contrast(accent, received_bg, history_in_fg, 3.0)
    out_reply_bar = ensure_contrast(accent, sent_bg, history_out_fg, 3.0)
    in_reply_bar_selected = ensure_contrast(
        accent, received_selected, history_in_fg, 3.0
    )
    out_reply_bar_selected = ensure_contrast(
        accent, sent_selected, history_out_fg, 3.0
    )
    link_in_fg = ensure_contrast(accent, received_bg, history_in_fg, 4.5)
    link_out_fg = ensure_contrast(accent, sent_bg, history_out_fg, 4.5)
    mono_in_fg = ensure_contrast(colors["cyan"], received_bg, history_in_fg, 4.5)
    mono_out_fg = ensure_contrast(colors["cyan"], sent_bg, history_out_fg, 4.5)
    icon_fg = ensure_contrast(dark_fg, bg, fg, 3.0)
    icon_dark_fg = ensure_contrast(dark_fg, dark_bg, fg, 3.0)

    result = {
        "windowBg": bg,
        "windowFg": fg,
        "windowBgOver": lighter_bg,
        "windowBgRipple": selection,
        "windowFgOver": bright_fg,
        "windowSubTextFg": secondary_fg,
        "windowSubTextFgOver": secondary_over_fg,
        "windowBoldFg": bright_fg,
        "windowBoldFgOver": bright_fg,
        "windowBgActive": accent,
        "windowFgActive": active_fg,
        "windowActiveTextFg": accent,
        "windowShadowFg": "#000000",
        "windowShadowFgFallback": dark_bg,
        "shadowFg": "#00000032",
        "slideFadeOutBg": "#0000003c",
        "imageBg": "#000000",
        "imageBgTransparent": bg,
        "activeButtonBg": accent,
        "activeButtonBgOver": active_over,
        "activeButtonBgRipple": active_ripple,
        "activeButtonFg": active_fg,
        "activeButtonFgOver": active_fg,
        "activeButtonSecondaryFg": mix(active_fg, accent, 0.30),
        "activeLineFg": accent,
        "activeLineFgError": red,
        "lightButtonBg": bg,
        "lightButtonBgOver": lighter_bg,
        "lightButtonBgRipple": selection,
        "lightButtonFg": accent,
        "lightButtonFgOver": active_over,
        "attentionButtonFg": red,
        "attentionButtonFgOver": red,
        "attentionButtonBgOver": mix(bg, red, 0.16),
        "attentionButtonBgRipple": mix(bg, red, 0.25),
        "outlineButtonBg": bg,
        "outlineButtonBgOver": lighter_bg,
        "outlineButtonOutlineFg": accent,
        "outlineButtonBgRipple": selection,
        "menuBg": bg,
        "menuBgOver": lighter_bg,
        "menuBgRipple": selection,
        "menuIconFg": icon_fg,
        "menuIconFgOver": bright_fg,
        "menuSubmenuArrowFg": secondary_over_fg,
        "menuFgDisabled": muted,
        "menuSeparatorFg": dark_bg,
        "scrollBarBg": rgba(muted, "73"),
        "scrollBarBgOver": rgba(muted, "a6"),
        "scrollBg": rgba(muted, "24"),
        "scrollBgOver": rgba(muted, "40"),
        "placeholderFg": secondary_fg,
        "placeholderFgActive": secondary_over_fg,
        "inputBorderFg": muted,
        "filterInputBorderFg": accent,
        "filterInputActiveBg": bg,
        "filterInputInactiveBg": dark_bg,
        "checkboxFg": muted,
        "sliderBgInactive": muted,
        "sliderBgActive": accent,
        "tooltipBg": dark_bg,
        "tooltipFg": fg,
        "tooltipBorderFg": muted,
        "radialBg": "#00000056",
        "titleShadow": "#00000018",
        "titleBg": dark_bg,
        "titleBgActive": bg,
        "titleFg": secondary_dark_fg,
        "titleFgActive": fg,
        "boxBg": bg,
        "boxTextFg": fg,
        "boxTextFgGood": green,
        "boxTextFgError": red,
        "boxTitleFg": bright_fg,
        "boxTitleAdditionalFg": secondary_fg,
        "dialogsBg": bg,
        "dialogsNameFg": bright_fg,
        "dialogsDateFg": secondary_fg,
        "dialogsTextFg": secondary_fg,
        "dialogsTextFgService": accent,
        "dialogsDraftFg": red,
        "dialogsVerifiedIconBg": accent,
        "dialogsVerifiedIconFg": active_fg,
        "dialogsSentIconFg": green,
        "dialogsUnreadBg": accent,
        "dialogsUnreadBgMuted": muted,
        "dialogsUnreadFg": active_fg,
        "dialogsOnlineBadgeFg": green,
        "dialogsBgOver": lighter_bg,
        "dialogsNameFgOver": bright_fg,
        "dialogsDateFgOver": secondary_over_fg,
        "dialogsTextFgOver": secondary_over_fg,
        "dialogsBgActive": accent,
        "dialogsNameFgActive": active_fg,
        "dialogsDateFgActive": active_fg,
        "dialogsTextFgActive": active_fg,
        "dialogsDraftFgActive": mix(active_fg, accent, 0.25),
        "dialogsSendingIconFgActive": rgba(active_fg, "99"),
        "dialogsOnlineBadgeFgActive": active_fg,
        "searchedBarBg": dark_bg,
        "searchedBarFg": secondary_dark_fg,
        "topBarBg": bg,
        "emojiPanBg": bg,
        "emojiPanCategories": dark_bg,
        "emojiPanHeaderFg": secondary_fg,
        "emojiPanHeaderBg": rgba(bg, "f2"),
        "emojiIconFg": icon_fg,
        "emojiIconFgActive": accent,
        "stickerPanDeleteBg": "#000000",
        "historyTextInFg": history_in_fg,
        "historyTextOutFg": history_out_fg,
        "historyLinkInFg": link_in_fg,
        "historyLinkOutFg": link_out_fg,
        "historyOutIconFg": out_icon_fg,
        "historyOutIconFgSelected": out_icon_fg_selected,
        "historySendingOutIconFg": ensure_contrast(
            mix(history_out_fg, muted, 0.35), sent_bg, history_out_fg, 3.0
        ),
        "historyUnreadBarBg": dark_bg,
        "historyUnreadBarFg": accent,
        "historyForwardChooseBg": "#0000004c",
        "msgInBg": received_bg,
        "msgInBgSelected": received_selected,
        "msgOutBg": sent_bg,
        "msgOutBgSelected": sent_selected,
        "msgSelectOverlay": rgba(accent, "4c"),
        "msgStickerOverlay": rgba(accent, "7f"),
        "msgInServiceFg": in_service_fg,
        "msgInServiceFgSelected": in_service_fg_selected,
        "msgOutServiceFg": out_service_fg,
        "msgOutServiceFgSelected": out_service_fg_selected,
        "msgInShadow": "#00000024",
        "msgInShadowSelected": "#00000030",
        "msgOutShadow": "#00000024",
        "msgOutShadowSelected": "#00000030",
        "msgInDateFg": message_secondary_fg,
        "msgInDateFgSelected": ensure_contrast(
            light_fg, received_selected, history_in_fg, 4.5
        ),
        "msgOutDateFg": message_out_secondary_fg,
        "msgOutDateFgSelected": ensure_contrast(
            mix(fg, accent, 0.40), sent_selected, history_out_fg, 4.5
        ),
        "msgServiceFg": active_fg,
        "msgServiceBg": rgba(accent, "90"),
        "msgServiceBgSelected": rgba(selection, "b8"),
        "msgInReplyBarColor": in_reply_bar,
        "msgInReplyBarSelColor": in_reply_bar_selected,
        "msgOutReplyBarColor": out_reply_bar,
        "msgOutReplyBarSelColor": out_reply_bar_selected,
        "msgInMonoFg": mono_in_fg,
        "msgOutMonoFg": mono_out_fg,
        "msgFileInBg": accent,
        "msgFileInBgOver": active_over,
        "msgFileInBgSelected": mix(accent, selection, 0.35),
        "msgFileOutBg": accent,
        "msgFileOutBgOver": active_over,
        "msgFileOutBgSelected": mix(accent, selection, 0.35),
        "msgDateImgBg": "#00000070",
        "msgDateImgBgOver": "#0000008f",
        "msgBotKbRippleBg": "#00000020",
        "historyComposeAreaBg": bg,
        "historyComposeAreaFg": fg,
        "historyComposeIconFg": icon_fg,
        "historyComposeIconFgOver": bright_fg,
        "historySendIconFg": accent,
        "historySendIconFgOver": active_over,
        "historyPinnedBg": bg,
        "historyReplyBg": bg,
