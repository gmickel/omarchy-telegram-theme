        "mediaviewFileNameFg": fg,
        "mediaviewFileSizeFg": secondary_fg,
        "mediaviewMenuBg": darker_bg,
        "mediaviewMenuBgOver": dark_bg,
        "mediaviewMenuBgRipple": lighter_bg,
        "mediaviewMenuFg": bright_fg,
        "mediaviewBg": rgba(darker_bg, "f2"),
        "mediaviewCaptionBg": "#0000009a",
        "mediaviewCaptionFg": bright_fg,
        "callBg": rgba(darker_bg, "f2"),
        "callBgOpaque": darker_bg,
        "callBgButton": rgba(dark_bg, "b8"),
        "callNameFg": bright_fg,
        "callStatusFg": light_fg,
        "callIconFg": bright_fg,
        "callIconFgActive": darker_bg,
        "callAnswerBg": green,
        "callHangupBg": red,
        "groupCallBg": darker_bg,
        "groupCallActiveFg": accent,
        "groupCallMembersBg": dark_bg,
        "groupCallMembersBgOver": bg,
        "groupCallMembersBgRipple": lighter_bg,
        "groupCallMembersFg": bright_fg,
        "groupCallMemberActiveIcon": green,
        "groupCallMemberActiveStatus": green,
        "groupCallMemberInactiveIcon": muted,
        "groupCallMemberInactiveStatus": accent,
        "groupCallMemberMutedIcon": red,
        "groupCallMemberNotJoinedStatus": secondary_dark_fg,
        "groupCallIconFg": bright_fg,
        "groupCallLeaveBg": rgba(red, "9e"),
        "groupCallLeaveBgRipple": rgba(red, "c0"),
        "callBarBg": accent,
        "callBarFg": active_fg,
        "sideBarBg": dark_bg,
        "sideBarBgActive": bg,
        "sideBarBgRipple": selection,
        "sideBarTextFg": secondary_dark_fg,
        "sideBarTextFgActive": accent,
        "sideBarIconFg": icon_dark_fg,
        "sideBarIconFgActive": accent,
        "sideBarBadgeBg": accent,
        "sideBarBadgeBgMuted": muted,
        "sideBarBadgeFg": active_fg,
    }

    peer_colors = (
        colors["red"],
        colors["green"],
        colors["yellow"],
        colors["blue"],
        colors["magenta"],
        mix(colors["red"], colors["magenta"], 0.5),
        colors["cyan"],
        mix(colors["red"], colors["yellow"], 0.5),
    )
    for index, color in enumerate(peer_colors, start=1):
        result[f"historyPeer{index}NameFg"] = color
        result[f"historyPeer{index}UserpicBg"] = mix(bg, color, 0.72)
        result[f"historyPeer{index}UserpicBg2"] = color

    file_colors = (
        colors["blue"],
        colors["green"],
        colors["red"],
        colors["yellow"],
    )
    for index, color in enumerate(file_colors, start=1):
        result[f"msgFile{index}Bg"] = mix(bg, color, 0.72)
        result[f"msgFile{index}BgDark"] = color
        result[f"msgFile{index}BgOver"] = mix(color, bright_fg, 0.10)
        result[f"msgFile{index}BgSelected"] = mix(color, selection, 0.32)

    return result


def render_palette(base: str, colors: dict[str, str], theme_name: str) -> str:
    overrides = palette_overrides(colors)
    rendered: list[str] = [
        "// Generated by omarchy-telegram-theme. Do not edit; it is replaced on theme changes.",
        f"// Omarchy theme: {theme_name or 'unknown'} ({colors['mode']})",
    ]
    seen: set[str] = set()

    for line in base.splitlines():
        match = PALETTE_LINE.match(line)
        if not match:
            rendered.append(line)
            continue
        key = match.group("prefix").split(":", 1)[0]
        if key in seen:
            raise ThemeError(f"duplicate key in base palette: {key}")
        seen.add(key)
        value = overrides.get(
            key, recolor_literal(key, match.group("value"), colors)
        )
        rendered.append(match.group("prefix") + value + match.group("suffix"))

    missing = sorted(set(overrides) - seen)
    if missing:
        rendered.append("// Keys added after the bundled upstream palette snapshot.")
        rendered.extend(f"{key}: {overrides[key]};" for key in missing)

    return "\n".join(rendered) + "\n"


def png_solid_color(color: str) -> bytes:
    """Return a minimal opaque 1x1 RGB PNG for Telegram's chat wallpaper."""
    pixel = bytes(rgb(color))

    def chunk(kind: bytes, data: bytes) -> bytes:
        checksum = zlib.crc32(kind + data) & 0xFFFFFFFF
        return (
            struct.pack(">I", len(data))
            + kind
            + data
            + struct.pack(">I", checksum)
        )

    header = struct.pack(">IIBBBBB", 1, 1, 8, 2, 0, 0, 0)
    image = zlib.compress(b"\x00" + pixel)
    return (
        b"\x89PNG\r\n\x1a\n"
        + chunk(b"IHDR", header)
        + chunk(b"IDAT", image)
        + chunk(b"IEND", b"")
    )


def build_theme_package(palette: str, wallpaper_color: str) -> bytes:
    """Bundle the palette and wallpaper in Telegram's ZIP theme format."""
    output = io.BytesIO()
    encoded = palette.encode("utf-8")
    background = png_solid_color(wallpaper_color)
    with zipfile.ZipFile(output, "w") as archive:
        # Ship both names: loadcolors accepts *.tdesktop-palette packages, while
        # Chat settings "Choose from file" historically looks for colors.tdesktop-theme.
        for name, content in (
            ("colors.tdesktop-theme", encoded),
            ("colors.tdesktop-palette", encoded),
            ("background.png", background),
        ):
            entry = zipfile.ZipInfo(name, date_time=(1980, 1, 1, 0, 0, 0))
            entry.compress_type = zipfile.ZIP_STORED
            entry.create_system = 3
            entry.external_attr = 0o644 << 16
            archive.writestr(entry, content)
    return output.getvalue()


def ensure_theme_extension_alias(path: Path) -> None:
    """Hard-link .tdesktop-theme ↔ .tdesktop-palette when possible."""
    name = path.name
    if name.endswith(".tdesktop-theme"):
        alias = path.with_name(name[: -len(".tdesktop-theme")] + ".tdesktop-palette")
    elif name.endswith(".tdesktop-palette"):
        alias = path.with_name(name[: -len(".tdesktop-palette")] + ".tdesktop-theme")
    else:
        return

    try:
        if alias.exists() or alias.is_symlink():
            if alias.samefile(path):
                return
            alias.unlink()
        os.link(path, alias)
    except OSError:
        # Cross-device or permission issues: fall back to a second in-place copy.
        try:
            write_if_changed(alias, path.read_bytes())
        except OSError:
            pass


def write_if_changed(path: Path, content: str | bytes) -> bool:
    """Update the theme package without breaking Telegram's file watcher.

    Telegram uses QFileSystemWatcher on the applied path. Atomic replace
    (tempfile + os.replace) changes the inode, so inotify drops the watch and
    later Omarchy theme switches no longer live-reload. Overwriting in place
    keeps the same inode and the watcher stays attached.
    """
    data = content.encode("utf-8") if isinstance(content, str) else content
    try:
        if path.read_bytes() == data:
            return False
    except FileNotFoundError:
        pass

    path.parent.mkdir(parents=True, exist_ok=True)
    if path.exists():
        with path.open("r+b") as stream:
            stream.write(data)
            stream.truncate()
            stream.flush()
            os.fsync(stream.fileno())
        return True

    descriptor, temporary = tempfile.mkstemp(
        dir=path.parent, prefix=f".{path.name}."
    )
    try:
        with os.fdopen(descriptor, "wb") as stream:
            stream.write(data)
            stream.flush()
            os.fsync(stream.fileno())
        os.chmod(temporary, 0o644)
        os.replace(temporary, path)
    finally:
        try:
            os.unlink(temporary)
        except FileNotFoundError:
            pass
    return True


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        description="Generate a Telegram Desktop theme package from Omarchy colors.toml"
    )
    parser.add_argument("--colors", type=Path, default=default_colors_file())
    parser.add_argument("--output", type=Path, default=default_output_file())
    parser.add_argument("--base-palette", type=Path)
    parser.add_argument("--theme", default="")
    parser.add_argument(
        "--stdout",
        action="store_true",
        help="print the palette instead of writing the theme package",
    )
    parser.add_argument(
        "--check", action="store_true", help="validate inputs without writing"
    )
    return parser


def main(argv: list[str] | None = None) -> int:
    args = build_parser().parse_args(argv)
    try:
        colors = read_omarchy_colors(args.colors.expanduser())
        base_path = (
            args.base_palette.expanduser() if args.base_palette else find_base_palette()
        )
        base = read_base_palette(base_path)
        palette = render_palette(base, colors, args.theme)
        package = build_theme_package(palette, colors["background"])
        if args.check:
            print(
                f"valid: {args.colors.expanduser()} -> "
                f"{len(palette.splitlines())} palette lines with chat wallpaper"
            )
        elif args.stdout:
            sys.stdout.write(palette)
        else:
            output = args.output.expanduser()
            changed = write_if_changed(output, package)
            # Keep a same-inode sibling with the other extension so either
            # "Import existing theme" (*.tdesktop-theme) or loadcolors
            # (*.tdesktop-palette) can point at one watched file.
            ensure_theme_extension_alias(output)
            print(f"{'updated' if changed else 'unchanged'}: {output}")
        return 0
    except ThemeError as error:
        print(f"omarchy-telegram-theme: {error}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    raise SystemExit(main())
