def render_palette(base: str, colors: dict[str, str], theme_name: str) -> str:
    overrides = palette_overrides(colors)
    rendered: list[str] = [
        "// Generated by omarchy-telegram-theme. Do not edit; it is replaced on theme changes.",
        f"// Omarchy theme: {theme_name or 'unknown'} ({colors['mode']})",
    ]
    seen: set[str] = set()

    for line in base.splitlines():
        match = PALETTE_LINE.match(line)
        if not match:
            rendered.append(line)
            continue
        key = match.group("prefix").split(":", 1)[0]
        if key in seen:
            raise ThemeError(f"duplicate key in base palette: {key}")
        seen.add(key)
        value = overrides.get(
            key, recolor_literal(key, match.group("value"), colors)
        )
        rendered.append(match.group("prefix") + value + match.group("suffix"))

    missing = sorted(set(overrides) - seen)
    if missing:
        rendered.append("// Keys added after the bundled upstream palette snapshot.")
        rendered.extend(f"{key}: {overrides[key]};" for key in missing)

    return "\n".join(rendered) + "\n"


def png_solid_color(color: str) -> bytes:
    """Return a minimal opaque 1x1 RGB PNG for Telegram's chat wallpaper."""
    pixel = bytes(rgb(color))

    def chunk(kind: bytes, data: bytes) -> bytes:
        checksum = zlib.crc32(kind + data) & 0xFFFFFFFF
        return (
            struct.pack(">I", len(data))
            + kind
            + data
            + struct.pack(">I", checksum)
        )

    header = struct.pack(">IIBBBBB", 1, 1, 8, 2, 0, 0, 0)
    image = zlib.compress(b"\x00" + pixel)
    return (
        b"\x89PNG\r\n\x1a\n"
        + chunk(b"IHDR", header)
        + chunk(b"IDAT", image)
        + chunk(b"IEND", b"")
    )


def build_theme_package(palette: str, wallpaper_color: str) -> bytes:
    """Bundle the palette and wallpaper in Telegram's ZIP theme format."""
    output = io.BytesIO()
    with zipfile.ZipFile(output, "w") as archive:
        for name, content in (
            ("colors.tdesktop-palette", palette.encode("utf-8")),
            ("background.png", png_solid_color(wallpaper_color)),
        ):
            entry = zipfile.ZipInfo(name, date_time=(1980, 1, 1, 0, 0, 0))
            entry.compress_type = zipfile.ZIP_STORED
            entry.create_system = 3
            entry.external_attr = 0o644 << 16
            archive.writestr(entry, content)
    return output.getvalue()


def write_if_changed(path: Path, content: str | bytes) -> bool:
    data = content.encode("utf-8") if isinstance(content, str) else content
    try:
        if path.read_bytes() == data:
            return False
    except FileNotFoundError:
        pass

    path.parent.mkdir(parents=True, exist_ok=True)
    descriptor, temporary = tempfile.mkstemp(
        dir=path.parent, prefix=f".{path.name}."
    )
    try:
        with os.fdopen(descriptor, "wb") as stream:
            stream.write(data)
            stream.flush()
            os.fsync(stream.fileno())
        os.chmod(temporary, 0o644)
        os.replace(temporary, path)
    finally:
        try:
            os.unlink(temporary)
        except FileNotFoundError:
            pass
    return True


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        description="Generate a Telegram Desktop theme package from Omarchy colors.toml"
    )
    parser.add_argument("--colors", type=Path, default=default_colors_file())
    parser.add_argument("--output", type=Path, default=default_output_file())
    parser.add_argument("--base-palette", type=Path)
    parser.add_argument("--theme", default="")
    parser.add_argument(
        "--stdout",
        action="store_true",
        help="print the palette instead of writing the theme package",
    )
    parser.add_argument(
        "--check", action="store_true", help="validate inputs without writing"
    )
    return parser


def main(argv: list[str] | None = None) -> int:
    args = build_parser().parse_args(argv)
    try:
        colors = read_omarchy_colors(args.colors.expanduser())
        base_path = (
            args.base_palette.expanduser() if args.base_palette else find_base_palette()
        )
        base = read_base_palette(base_path)
        palette = render_palette(base, colors, args.theme)
        package = build_theme_package(palette, colors["background"])
        if args.check:
            print(
                f"valid: {args.colors.expanduser()} -> "
                f"{len(palette.splitlines())} palette lines with chat wallpaper"
            )
        elif args.stdout:
            sys.stdout.write(palette)
        else:
            output = args.output.expanduser()
            changed = write_if_changed(output, package)
            print(f"{'updated' if changed else 'unchanged'}: {output}")
        return 0
    except ThemeError as error:
        print(f"omarchy-telegram-theme: {error}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    raise SystemExit(main())
